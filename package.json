{
  "name": "clinika",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "legal:publish": "tsx scripts/publish-legal-documents.ts",
    "specialist:publish": "tsx scripts/publish-featured-specialist.ts",
    "reviews:publish": "tsx scripts/publish-featured-reviews.ts",
    "pricing:publish": "tsx scripts/publish-current-price-list.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "latest",
    "clsx": "latest",
    "date-fns": "latest",
    "date-fns-tz": "latest",
    "lucide-react": "latest",
    "nanoid": "latest",
    "next": "latest",
    "papaparse": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "tailwind-merge": "latest",
    "three": "^0.187.0",
    "undici": "^7.13.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/papaparse": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.6.1",
    "eslint": "9.39.2",
    "eslint-config-next": "latest",
    "jsdom": "latest",
    "postcss": "^8.5.6",
    "prettier": "latest",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "latest",
    "typescript": "6.0.3",
    "vitest": "latest"
  }
}
